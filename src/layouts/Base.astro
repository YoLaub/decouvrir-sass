---
import { neighbors } from "../lib/pages";
interface Props { title: string }
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
const slug = Astro.url.pathname.replace(base, "").replace(/^\/|\/$/g, "");
const { prev, next } = neighbors(slug);
const isTp = slug === "tp";
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {isTp && <meta name="robots" content="noindex" />}
    <title>{title} · Découvrir Sass</title>
  </head>
  <body>
    <header>
      <a class="brand" href={base}>Découvrir Sass</a>
      <span class="tag">Formation CDA</span>
    </header>
    <main>
      <slot />
      {(prev || next) && (
        <nav class="pager" aria-label="Navigation du cours">
          {prev ? <a class="prev" href={`${base}${prev.slug}`}>← {prev.title}</a> : <span />}
          {next ? <a class="next" href={`${base}${next.slug}`}>{next.title} →</a> : <span />}
        </nav>
      )}
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafafa; --ink: #1a1a1a; --muted: #5b6070; --accent: #CF649A;
    --panel: #ffffff; --line: #e3e5ec; --code-bg: #0e1016; --code-ink: #e6e8ee; --err: #ff5d5d;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 18px/1.6 Inter, system-ui, sans-serif; }
  header { display: flex; align-items: baseline; gap: 16px; padding: 16px 32px; border-bottom: 1px solid var(--line); background: var(--panel); }
  .brand { font-weight: 800; color: var(--ink); text-decoration: none; font-size: 22px; }
  .tag { color: var(--muted); font-size: 15px; }
  main { max-width: 1100px; margin: 0 auto; padding: 32px; }
  h1 { font-size: 40px; line-height: 1.15; margin: 0 0 8px; letter-spacing: -0.02em; }
  h2 { font-size: 28px; margin: 48px 0 8px; }
  code { font-family: "JetBrains Mono", ui-monospace, monospace; background: #eceef5; padding: 1px 6px; border-radius: 5px; font-size: 0.9em; }
  .lead { color: var(--muted); font-size: 20px; margin: 0 0 24px; }
  a { color: #a23b74; }
  .pager { display: flex; justify-content: space-between; gap: 16px; margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--line); font-weight: 700; }
  .pager a { text-decoration: none; padding: 10px 16px; border: 2px solid var(--accent); border-radius: 10px; color: var(--ink); }
  .pager a:hover { background: var(--accent); }
  details { margin: 12px 0 24px; padding: 12px 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; }
  summary { cursor: pointer; font-weight: 700; }
</style>
