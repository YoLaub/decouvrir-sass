---
interface Props { minutes: number }
const { minutes } = Astro.props;
---
<div class="chrono" data-chrono data-seconds={minutes * 60}>
  <span class="time" aria-live="off">{String(minutes).padStart(2, "0")}:00</span>
  <button type="button" class="go">Démarrer le chrono</button>
  <button type="button" class="reset">Remettre à zéro</button>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-chrono]").forEach((root) => {
    const total = Number(root.dataset.seconds);
    const time = root.querySelector<HTMLElement>(".time")!;
    const go = root.querySelector<HTMLButtonElement>(".go")!;
    const reset = root.querySelector<HTMLButtonElement>(".reset")!;
    let left = total;
    let timer: number | undefined;
    const show = () => {
      time.textContent = `${String(Math.floor(left / 60)).padStart(2, "0")}:${String(left % 60).padStart(2, "0")}`;
      root.classList.toggle("over", left === 0);
    };
    const stop = () => { window.clearInterval(timer); timer = undefined; go.textContent = "Reprendre"; };
    go.addEventListener("click", () => {
      if (timer !== undefined) return stop();
      go.textContent = "Pause";
      timer = window.setInterval(() => { left = Math.max(0, left - 1); show(); if (left === 0) stop(); }, 1000);
    });
    reset.addEventListener("click", () => { window.clearInterval(timer); timer = undefined; left = total; go.textContent = "Démarrer le chrono"; show(); });
  });
</script>

<style>
  .chrono { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin: 16px 0; padding: 12px 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; }
  .time { font: 800 34px "JetBrains Mono", ui-monospace, monospace; min-width: 5ch; }
  .over .time { color: var(--err); }
  button { font: 600 15px Inter, system-ui, sans-serif; padding: 8px 14px; border-radius: 8px; border: 2px solid var(--line); background: var(--panel); cursor: pointer; }
</style>
